APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# TiDB Cloud requires TLS: put the ISRG Root X1 certificate in storage/certs/
# (kept out of Git) and point here with a path relative to the project folder.
# MYSQL_ATTR_SSL_CA=storage/certs/isrgrootx1.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true wherever the site is served over HTTPS (render.yaml does).
# Leave it unset for local http://localhost, or sign-in won't stick.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Account security ---
# REQUIRE_2FA: none | staff (admins + supervisors) | all
REQUIRE_2FA=none
# Accounts created before this date get TWO_FACTOR_GRACE_DAYS of reminders first.
TWO_FACTOR_ENFORCED_SINCE=
TWO_FACTOR_GRACE_DAYS=14
# Never forced into setup (demo accounts). Keep empty in production.
TWO_FACTOR_EXEMPT_EMAILS=maria.cruz@pnp.gov.ph,admin.demo@pnp.gov.ph,supervisor.demo@pnp.gov.ph
TWO_FACTOR_RECOVERY_LINK_MINUTES=30

# --- Terms of Service & Privacy Notice (config/legal.php) ---
# Bump LEGAL_VERSION when either document changes; users are asked to accept again.
LEGAL_VERSION=2026-11-24
LEGAL_EFFECTIVE_DATE="24 November 2026"
# Keep true until PNP Legal Service and the DPO approve the text.
LEGAL_DRAFT=true
LEGAL_CONTROLLER_NAME="Philippine National Police"
LEGAL_CONTROLLER_OFFICE="Directorate for Human Resource and Doctrine Development (DHRDD)"
LEGAL_CONTROLLER_ADDRESS=
LEGAL_DPO_EMAIL=
LEGAL_DPO_PHONE=
LEGAL_DATABASE_PROVIDER=
LEGAL_EMAIL_PROVIDER=
LEGAL_AI_ASSISTANT=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
